# ---- PSRAM -----------------------------------------------------------------
# The AI-Thinker datasheet claims 4MB, but many cheap clones ship with 0MB or
# 2MB. Run M0 (tools/check_psram) before anything else. If PSRAM is absent the
# camera will not initialise at VGA.
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_ESP32_SPIRAM_MODE_QUAD=y
CONFIG_ESP32_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---- CPU / scheduler --------------------------------------------------------
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Inference + capture must not be starved by WiFi. Raise the task watchdog.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_PANIC=n
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- Camera -----------------------------------------------------------------
CONFIG_CAMERA_PSRAM_DMA=y

# ---- Logging / mains stack --------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
